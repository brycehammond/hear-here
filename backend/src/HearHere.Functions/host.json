{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "default": "Information",
      "Host.Results": "Error",
      "Function": "Information"
    }
  },
  "extensions": {
    "durableTask": {
      "hubName": "HearHereModeration",
      "storageProvider": {
        "type": "azure-storage"
      }
    },
    "serviceBus": {
      "prefetchCount": 10,
      "autoCompleteMessages": false
    }
  },
  "functionTimeout": "00:05:00"
}
